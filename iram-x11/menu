#!/data/data/com.termux/files/usr/bin/bash
# Rofi menus: menu power | menu keys
case "${1:-}" in
  power)
    c=$(printf 'Reload desktop\nLog out\nCancel\n' | rofi -dmenu -i -p "Power") || exit 0
    case "$c" in
      "Reload desktop") i3-msg -q restart ;;
      "Log out") i3-msg -q exit ;;
    esac ;;
  keys)
    rofi -dmenu -i -p "Keys" >/dev/null <<KEYS
Super+Return / Alt+Return    Terminal
Super+Space / Ctrl+Space / Alt+Space    App launcher
Super+B    Browser
Super+E    Files
Super+T    Theme picker
Super+Shift+W    Next wallpaper
Super+Q / Super+W / Alt+Q    Close window
Super+F    Fullscreen
Super+Alt+V    Toggle floating
Super+J    Toggle split direction
Super+G    Tabbed group
Super+O    Keep on all workspaces
Super+R    Resize mode
Super+Arrows    Move focus
Super+Shift+Arrows    Move window
Super+1-0 / Alt+1-5    Switch workspace
Super+Shift+1-0    Move window to workspace
Super+Grave    Scratchpad
Super+Escape    Power menu
Super+M    Log out
KEYS
    ;;
  *) echo "Usage: menu power|keys" >&2; exit 2 ;;
esac
