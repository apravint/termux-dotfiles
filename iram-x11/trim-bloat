#!/data/data/com.termux/files/usr/bin/bash
# ============================================================================
# Trim bloat from Termux — turn it into a lean dev machine
# Run in normal Termux (not root/proot): ./trim-bloat
# Saves ~2 GB. Review each section — comment out what you want to keep.
# ============================================================================
set -euo pipefail

if [ "$(id -u)" = 0 ]; then
  echo "❌ Run this in normal Termux, not as root." >&2; exit 1
fi

echo "🔪 Trimming bloat from Termux..."
echo ""

# ── 1. Go: 224 MB — no Go projects found ──
echo "📦 Removing Go (224 MB)..."
pkg uninstall -y golang golang-doc 2>/dev/null || true

# ── 2. OpenJDK 17: 218 MB — you have JDK 21, Android projects use it ──
echo "📦 Removing OpenJDK 17 (218 MB, keeping 21)..."
pkg uninstall -y openjdk-17 2>/dev/null || true

# ── 3. Fluent GTK theme: 21 MB — not configured anywhere ──
echo "📦 Removing unused Fluent theme (21 MB)..."
pkg uninstall -y fluent-gtk-theme 2>/dev/null || true

# ── 4. Yazi: 31 MB — never used (you have Thunar + nnn) ──
echo "📦 Removing Yazi (31 MB)..."
pkg uninstall -y yazi 2>/dev/null || true

# ── 5. uv: 35 MB — never used (you have pip) ──
echo "📦 Removing uv (35 MB)..."
pkg uninstall -y uv 2>/dev/null || true

# ── 6. XFCE components replaced by i3 desktop ──
echo "📦 Removing XFCE components replaced by i3..."
pkg uninstall -y xfce4-panel xfce4-panel-profiles xfce4-whiskermenu-plugin \
  xfce4-power-manager xfdesktop xfwm4 parole 2>/dev/null || true
# Keep: xfce4-terminal (best terminal), xfce4-session (--xfce fallback),
#       thunar, mousepad, ristretto, xfce4-screenshooter, xfce4-taskmanager

# ── 7. Chromium: 643 MB — Firefox is lighter and you have it ──
# Uncomment if you only need one browser:
# echo "📦 Removing Chromium (643 MB, keeping Firefox)..."
# pkg uninstall -y chromium 2>/dev/null || true

# ── 8. Autoremove orphaned dependencies ──
echo "📦 Cleaning up orphaned packages..."
pkg autoremove -y 2>/dev/null || apt autoremove -y 2>/dev/null || true

# ── 9. Clear caches ──
echo "🧹 Clearing caches..."
pkg clean 2>/dev/null || true
npm cache clean --force 2>/dev/null || true
python3 -m pip cache purge 2>/dev/null || true

echo ""
echo "✅ Done! Space freed:"
df -h "$HOME" | awk 'NR==1 || NR==2'
