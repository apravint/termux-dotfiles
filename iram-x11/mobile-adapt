#!/data/data/com.termux/files/usr/bin/bash
# Adapts gaps for portrait phones vs landscape monitors.
set -u
S="$HOME/.local/state/iram-x11"
sw=0 sh=0
if command -v xdpyinfo >/dev/null 2>&1; then
  read -r sw sh < <(xdpyinfo 2>/dev/null | sed -n 's/.*dimensions:[[:space:]]*\([0-9]*\)x\([0-9]*\).*/\1 \2/p')
fi
if [ "$sh" -gt "$sw" ] 2>/dev/null; then
  i3-msg -q "gaps inner all set 2; gaps outer all set 1"
  echo "portrait" > "$S/orientation"
else
  i3-msg -q "gaps inner all set 6; gaps outer all set 6"
  echo "landscape" > "$S/orientation"
fi
