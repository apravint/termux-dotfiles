#!/data/data/com.termux/files/usr/bin/bash
# Open the first available app: open term|browser|files|editor|media|pdf|calc|settings|task|screenshot [args...]
kind="${1:-}"; shift || true
first() { for c in "$@"; do command -v "$c" >/dev/null && { echo "$c"; return 0; }; done; return 1; }
case "$kind" in
  term)
    t=$(first alacritty xfce4-terminal xterm) || exit 1
    if [ "${1:-}" = "-e" ]; then
      shift
      case "$t" in
        xfce4-terminal) exec "$t" -x "$@" ;;
        *) exec "$t" -e "$@" ;;
      esac
    fi
    exec "$t" ;;
  browser)
    b=$(first firefox chromium chromium-browser netsurf) && exec "$b" "$@"
    termux-open-url "${1:-https://www.google.com}" ;;
  files)
    f=$(first thunar pcmanfm nautilus) && exec "$f" "$@"
    exec "$0" term -e "${SHELL:-sh}" ;;
  editor)
    e=$(first geany mousepad leafpad) && exec "$e" "$@"
    exec "$0" term -e nvim "$@" ;;
  media)
    m=$(first mpv vlc parole) && exec "$m" "$@" ;;
  pdf)
    p=$(first evince zathura atril mupdf) && exec "$p" "$@" ;;
  calc)
    exec galculator ;;
  settings)
    exec lxappearance ;;
  task)
    exec xfce4-taskmanager ;;
  screenshot)
    s=$(first xfce4-screenshooter flameshot scrot) && exec "$s" "$@" ;;
  *) echo "Usage: open term|browser|files|editor|media|pdf|calc|settings|task|screenshot" >&2; exit 2 ;;
esac
